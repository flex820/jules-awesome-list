<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SHUTTLE - Clothing Brand</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background: #000;
            color: #fff;
            overflow-x: hidden;
        }

        /* Header */
        header {
            position: fixed;
            top: 0;
            width: 100%;
            background: rgba(0, 0, 0, 0.95);
            backdrop-filter: blur(10px);
            z-index: 1000;
            padding: 20px 0;
            transition: all 0.3s ease;
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .logo {
            font-size: 2em;
            font-weight: bold;
            letter-spacing: 3px;
            color: #fff;
            text-transform: uppercase;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 30px;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s ease;
            position: relative;
        }

        .nav-links a:hover {
            color: #ff6b6b;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: #ff6b6b;
            transition: width 0.3s ease;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        /* Hero Section */
        .hero {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(45deg, #000, #1a1a1a);
            position: relative;
            overflow: hidden;
        }

        .hero-content {
            text-align: center;
            z-index: 2;
        }

        .hero h1 {
            font-size: 5em;
            margin-bottom: 20px;
            letter-spacing: 5px;
            opacity: 0;
            animation: fadeInUp 1s ease forwards;
        }

        .hero p {
            font-size: 1.5em;
            margin-bottom: 30px;
            opacity: 0;
            animation: fadeInUp 1s ease 0.3s forwards;
        }

        .cta-button {
            display: inline-block;
            padding: 15px 40px;
            background: transparent;
            border: 2px solid #ff6b6b;
            color: #ff6b6b;
            text-decoration: none;
            font-weight: bold;
            letter-spacing: 2px;
            transition: all 0.3s ease;
            opacity: 0;
            animation: fadeInUp 1s ease 0.6s forwards;
        }

        .cta-button:hover {
            background: #ff6b6b;
            color: #000;
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(255, 107, 107, 0.3);
        }

        /* Products Section */
        .products {
            padding: 100px 20px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-title {
            text-align: center;
            font-size: 3em;
            margin-bottom: 60px;
            letter-spacing: 3px;
            position: relative;
        }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 3px;
            background: #ff6b6b;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 40px;
            margin-top: 60px;
        }

        .product-card {
            background: #111;
            border-radius: 15px;
            overflow: hidden;
            transition: all 0.3s ease;
            position: relative;
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(255, 107, 107, 0.2);
        }

        .product-image {
            width: 100%;
            height: 350px;
            background: #222;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2em;
            color: #666;
            position: relative;
            overflow: hidden;
        }

        .product-image::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, #ff6b6b, #4ecdc4);
            opacity: 0.1;
        }

        .product-info {
            padding: 25px;
        }

        .product-name {
            font-size: 1.5em;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .product-price {
            font-size: 1.8em;
            color: #ff6b6b;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .product-description {
            color: #ccc;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .order-button {
            width: 100%;
            padding: 12px;
            background: transparent;
            border: 2px solid #ff6b6b;
            color: #ff6b6b;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            letter-spacing: 1px;
        }

        .order-button:hover {
            background: #ff6b6b;
            color: #000;
        }

        /* Contact Section */
        .contact {
            padding: 100px 20px;
            background: #111;
            text-align: center;
        }

        .contact-content {
            max-width: 600px;
            margin: 0 auto;
        }

        .instagram-link {
            display: inline-flex;
            align-items: center;
            gap: 15px;
            padding: 20px 40px;
            background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
            color: #fff;
            text-decoration: none;
            border-radius: 50px;
            font-weight: bold;
            font-size: 1.2em;
            transition: all 0.3s ease;
            margin-top: 30px;
        }

        .instagram-link:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(240, 148, 51, 0.4);
        }

        /* Footer */
        footer {
            padding: 40px 20px;
            text-align: center;
            border-top: 1px solid #333;
        }

        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Mobile Responsive */
        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }

            .hero h1 {
                font-size: 3em;
            }

            .hero p {
                font-size: 1.2em;
            }

            .section-title {
                font-size: 2em;
            }

            .products-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #111;
        }

        ::-webkit-scrollbar-thumb {
            background: #ff6b6b;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #ff5252;
        }
    </style>
</head>
<body>
    <header>
        <nav>
            <div class="logo">SHUTTLE</div>
            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#products">Products</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <section class="hero" id="home">
        <div class="hero-content">
            <h1>SHUTTLE</h1>
            <p>Streetwear for the Bold</p>
            <a href="#products" class="cta-button">SHOP NOW</a>
        </div>
    </section>

    <section class="products" id="products">
        <h2 class="section-title">COLLECTION</h2>
        
        <div class="products-grid">
            <div class="product-card">
                <div class="product-image">
                    <span>Product Image</span>
                </div>
                <div class="product-info">
                    <h3 class="product-name">SHUTTLE TEE</h3>
                    <div class="product-price">$35</div>
                    <p class="product-description">Premium cotton tee featuring the iconic SHUTTLE logo. Comfortable fit for everyday streetwear.</p>
                    <button class="order-button" onclick="orderProduct('SHUTTLE TEE')">ORDER NOW</button>
                </div>
            </div>

            <div class="product-card">
                <div class="product-image">
                    <span>Product Image</span>
                </div>
                <div class="product-info">
                    <h3 class="product-name">SHUTTLE HOODIE</h3>
                    <div class="product-price">$65</div>
                    <p class="product-description">Heavy-weight hoodie with embroidered logo. Perfect for those cold nights and urban adventures.</p>
                    <button class="order-button" onclick="orderProduct('SHUTTLE HOODIE')">ORDER NOW</button>
                </div>
            </div>

            <div class="product-card">
                <div class="product-image">
                    <span>Product Image</span>
                </div>
                <div class="product-info">
                    <h3 class="product-name">SHUTTLE CAP</h3>
                    <div class="product-price">$25</div>
                    <p class="product-description">Adjustable snapback cap with embroidered SHUTTLE logo. Complete your streetwear look.</p>
                    <button class="order-button" onclick="orderProduct('SHUTTLE CAP')">ORDER NOW</button>
                </div>
            </div>

            <div class="product-card">
                <div class="product-image">
                    <span>Product Image</span>
                </div>
                <div class="product-info">
                    <h3 class="product-name">SHUTTLE JOGGERS</h3>
                    <div class="product-price">$55</div>
                    <p class="product-description">Comfortable joggers with side logo print. Perfect for street style and casual comfort.</p>
                    <button class="order-button" onclick="orderProduct('SHUTTLE JOGGERS')">ORDER NOW</button>
                </div>
            </div>

            <div class="product-card">
                <div class="product-image">
                    <span>Product Image</span>
                </div>
                <div class="product-info">
                    <h3 class="product-name">SHUTTLE JACKET</h3>
                    <div class="product-price">$85</div>
                    <p class="product-description">Windbreaker jacket with bold SHUTTLE branding. Stand out with this statement piece.</p>
                    <button class="order-button" onclick="orderProduct('SHUTTLE JACKET')">ORDER NOW</button>
                </div>
            </div>

            <div class="product-card">
                <div class="product-image">
                    <span>Product Image</span>
                </div>
                <div class="product-info">
                    <h3 class="product-name">SHUTTLE TANK</h3>
                    <div class="product-price">$28</div>
                    <p class="product-description">Lightweight tank top for summer vibes. Features minimalist SHUTTLE logo design.</p>
                    <button class="order-button" onclick="orderProduct('SHUTTLE TANK')">ORDER NOW</button>
                </div>
            </div>
        </div>
    </section>

    <section class="contact" id="contact">
        <div class="contact-content">
            <h2 class="section-title">GET IN TOUCH</h2>
            <p style="font-size: 1.2em; margin-bottom: 20px; color: #ccc;">Ready to order? Hit us up on Instagram!</p>
            <p style="margin-bottom: 30px; color: #999;">Send us a DM with your product choice, size, and shipping details.</p>
            
            <a href="https://instagram.com/shuttle_clothing" class="instagram-link" target="_blank">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
                @shuttle_clothing
            </a>
        </div>
    </section>

    <footer>
        <p>&copy; 2025 SHUTTLE. All rights reserved.</p>
    </footer>

    <script>
        // Smooth scrolling
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelector(this.getAttribute('href')).scrollIntoView({
                    behavior: 'smooth'
                });
            });
        });

        // Header scroll effect
        window.addEventListener('scroll', () => {
            const header = document.querySelector('header');
            if (window.scrollY > 100) {
                header.style.background = 'rgba(0, 0, 0, 0.98)';
                header.style.padding = '15px 0';
            } else {
                header.style.background = 'rgba(0, 0, 0, 0.95)';
                header.style.padding = '20px 0';
            }
        });

        // Order function
        function orderProduct(productName) {
            const message = `Hi! I'm interested in ordering the ${productName}. Could you please provide more details about sizes and shipping?`;
            const encodedMessage = encodeURIComponent(message);
            window.open(`https://instagram.com/shuttle_clothing`, '_blank');
        }

        // Product card animation on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        document.querySelectorAll('.product-card').forEach(card => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(50px)';
            card.style.transition = 'all 0.6s ease';
            observer.observe(card);
        });
    </script>
</body>
</html>
